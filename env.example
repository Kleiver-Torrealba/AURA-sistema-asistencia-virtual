# ─────────────────────────────────────────────────────────────────────────────
# AURA — Archivo de variables de entorno
# Nombre real del archivo: .env  (en la raíz del proyecto, junto a manage.py)
# Este archivo NUNCA se sube a GitHub — verificá que esté en tu .gitignore
# ─────────────────────────────────────────────────────────────────────────────


# ── Django ────────────────────────────────────────────────────────────────────
# Generá una clave nueva en: https://djecrety.ir/
SECRET_KEY=tu_clave_secreta_larga_aqui

# DESARROLLO: True | PRODUCCIÓN: False (o simplemente no incluir la línea)
DEBUG=True

# DESARROLLO: 127.0.0.1,localhost
# PRODUCCIÓN: tudominio.com,www.tudominio.com
ALLOWED_HOSTS=127.0.0.1,localhost


# ── Base de Datos (PostgreSQL) ────────────────────────────────────────────────
DB_NAME=db_ujap
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_HOST=localhost
DB_PORT=5432


# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Usá una "Contraseña de aplicación" de Google, no tu contraseña real.
# Guía: https://support.google.com/accounts/answer/185833
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=contraseña_de_aplicacion_16_chars
DEFAULT_FROM_EMAIL=AURA UJAP <tu_correo@gmail.com>
